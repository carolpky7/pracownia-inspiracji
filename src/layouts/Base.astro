---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageTransition from '../components/PageTransition.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  jsonLd?: object[];
}
const { title = site.title, description = site.description, jsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Preview builds (fictional events/testimonials) must never be indexed
const isPreview = import.meta.env.MODE === 'preview' || import.meta.env.PUBLIC_SHOW_PREVIEW_EVENTS === 'true';
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#121214" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-default.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      (function () {
        var h = document.documentElement;
        h.classList.add('js');
        // Page transition: arriving from another page of this site → cover before first paint
        try {
          if (sessionStorage.getItem('piro:pt') === '1' && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
            h.classList.add('pt-arrive');
          }
        } catch (e) {}
      })();
    </script>
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <PageTransition />
    <a class="skip-link" href="#tresc">Przejdź do treści</a>
    <Header current={Astro.url.pathname} />
    <main id="tresc" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
