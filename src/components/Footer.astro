---
/** Footer (§4.10) */
import { pillars } from '../data/pillars';
import { site } from '../data/site';
import PillarIcon from './PillarIcon.astro';
---
<footer class="footer on-ink">
  <div class="footer__bar" aria-hidden="true">
    <span style="background:var(--pink)"></span>
    <span style="background:var(--pillar-edu)"></span>
    <span style="background:var(--pillar-ngo)"></span>
    <span style="background:var(--pillar-biz)"></span>
  </div>
  <div class="container footer__grid">
    <div class="footer__brand">
      <img src="/logo/inspiracja-white@2x.png" srcset="/logo/inspiracja-white@2x.png 2x, /logo/inspiracja-white@3x.png 3x" width="125" height="52" alt="inspıracja" loading="lazy" decoding="async" />
      <p class="footer__motto">„{site.motto.text}”<span>{site.motto.author}. Moje motto.</span></p>
    </div>

    <nav class="footer__col" aria-label="Obszary pracy">
      <h2 class="footer__h">Pracownia Inspiracji Rozwoju…</h2>
      <ul role="list">
        {pillars.map((p) => (
          <li data-pillar={p.id}>
            <a href={p.href}><PillarIcon icon={p.icon} size={14} color="var(--p-on-ink)" />{p.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="footer__col">
      <h2 class="footer__h">Kontakt</h2>
      <address>
        <a href={site.phoneHref}>{site.phone}</a><br />
        <a href={`mailto:${site.email}`}>{site.email}</a><br />
        <span>{site.address.street}, {site.address.postalCode} {site.address.city}</span><br />
        <a href={site.facebook} rel="noopener" target="_blank">Facebook: inspiracjaPIRO</a>
      </address>
    </div>
  </div>
  <div class="container footer__legal">
    <p>© {new Date().getFullYear()} {site.legalName}</p>
    <a href="/polityka-prywatnosci">Polityka prywatności</a>
  </div>
</footer>

<style>
  .footer { background: var(--ink); color: var(--on-ink); }
  .footer__bar { display: grid; grid-template-columns: repeat(4, 1fr); height: 4px; }
  .footer__grid {
    display: grid;
    grid-template-columns: 5fr 4fr 3fr;
    gap: 3rem var(--gap);
    padding-block: clamp(4rem, 8vw, 6rem) 3rem;
  }
  .footer__motto {
    margin-top: 2rem;
    max-width: 28ch;
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.3;
  }
  .footer__motto span {
    display: block;
    margin-top: 0.75rem;
    font-family: var(--font-text);
    font-size: var(--fs-small);
    color: var(--on-ink-muted);
  }
  .footer__h {
    font-family: var(--font-text);
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-ink-muted);
    margin-bottom: 1.25rem;
  }
  .footer__col ul { display: grid; gap: 0.25rem; }
  .footer__col a {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 40px;
    color: var(--on-ink);
    text-decoration: none;
  }
  .footer__col a:hover { color: var(--p-on-ink, #fff); text-decoration: underline; text-underline-offset: 0.25em; }
  .footer address { font-style: normal; line-height: 2.2; color: var(--on-ink-muted); }
  .footer address a { display: inline; min-height: 0; }
  .footer a:focus-visible { outline-color: var(--on-ink); }
  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid var(--on-ink-line);
    font-size: var(--fs-small);
    color: var(--on-ink-muted);
  }
  .footer__legal a { color: var(--on-ink-muted); }

  @media (max-width: 899px) {
    .footer__grid { grid-template-columns: 1fr 1fr; }
    .footer__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 559px) {
    .footer__grid { grid-template-columns: 1fr; }
  }
</style>
