---
/**
 * HERO (§4.1): asymmetric 12-col layout. Text cols 1–6 on white, portrait cols 7–12.
 * H1 "Pracownia / Inspiracji / Rozwoju…" — the sentence continues in the pillars block.
 */
import Signet from './Signet.astro';
import { Picture } from 'astro:assets';
import heroPhoto from '../assets/photos/katarzyna-hero.jpg';
import { upcomingEvents, dateParts } from '../data/events';

const next = upcomingEvents()[0];
const nextParts = next ? dateParts(next) : null;
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__watermark" aria-hidden="true">
    <Signet ignite />
  </div>

  <div class="container hero__grid">
    <div class="hero__text">
      <h1 class="hero__title" id="hero-title">
        <span class="hero__line">Pracownia</span>
        <span class="hero__line">Insp<span class="idot hero__idot" data-pillar="osobisty">ı</span>racji</span>
        <span class="hero__line">Rozwoju<span class="hero__ellipsis" aria-hidden="true"><span>.</span><span>.</span><span>.</span></span></span>
      </h1>

      <p class="hero__sign">
        <span class="visually-hidden">Autorka: </span>
        <span class="hero__sign-text">by Katarzyna Janina Lipska</span>
      </p>

      <p class="hero__lead">
        Warsztaty, sesje i&nbsp;wystąpienia, po których chce się działać. Dla kobiet, szkół, organizacji i&nbsp;firm.
      </p>

      <div class="hero__actions">
        <a class="btn btn--primary" href="#wydarzenia">Zobacz najbliższe warsztaty</a>
        <a class="link" href="/o-mnie">Poznaj mnie<span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="hero__media">
      <Picture
        src={heroPhoto}
        formats={['avif', 'webp']}
        widths={[480, 720, 960, 1200, 1440]}
        sizes="(max-width: 799px) 100vw, 50vw"
        alt="Katarzyna Janina Lipska w czarnej bluzce i białych spodniach stoi przy dużym oknie, zalana ciepłym światłem, patrzy w dal"
        class="hero__photo"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />

      {next && nextParts && (
        <a class="hero__badge" href={next.url} data-pillar={next.pillar} data-event-date={next.date}>
          <span class="hero__badge-date">{nextParts.dayMonth}</span>
          <span class="hero__badge-body">
            <span class="hero__badge-title">{next.title}</span>
            <span class="hero__badge-place">{next.place}</span>
          </span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      )}
    </div>
  </div>

  <a class="hero__cue" href="#filary" aria-label="Przewiń do czterech obszarów pracy">
    <span class="hero__cue-line"></span>
    <span class="hero__cue-dot"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    background: var(--bg-canvas);
  }

  /* Big signet watermark, cropped by the left edge (§4.1) */
  .hero__watermark {
    position: absolute;
    left: -16vh;
    top: 4vh;
    width: max(64vh, 360px);
    color: #f6f6f7;
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    min-height: calc(92svh - var(--header-h));
  }

  .hero__text {
    grid-column: 1 / span 7;
    grid-row: 1;
    z-index: 2;
    align-self: center;
    padding-block: clamp(4rem, 9vh, 7rem);
  }

  .hero__title {
    font-size: var(--fs-display);
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    text-wrap: initial;
  }
  .hero__line {
    display: block;
    opacity: 0;
    transform: translateY(0.12em);
    animation: line-in 900ms var(--ease-out-expo) forwards;
  }
  .hero__line:nth-child(1) { animation-delay: 80ms; }
  .hero__line:nth-child(2) { animation-delay: 180ms; }
  .hero__line:nth-child(3) { animation-delay: 280ms; }
  @keyframes line-in { to { opacity: 1; transform: none; } }

  /* The spark: the magenta dot over ı ignites after the words land */
  .hero__idot::after {
    animation: spark 700ms var(--ease-spring) 900ms both;
  }
  @keyframes spark {
    from { opacity: 0; transform: translateX(-50%) scale(0.2); }
    to   { opacity: 1; transform: translateX(-50%) scale(1); }
  }

  /* Ellipsis: dots appear one by one, once — the sentence continues below */
  .hero__ellipsis span {
    opacity: 0;
    animation: fade 300ms linear forwards;
  }
  .hero__ellipsis span:nth-child(1) { animation-delay: 1300ms; }
  .hero__ellipsis span:nth-child(2) { animation-delay: 1450ms; }
  .hero__ellipsis span:nth-child(3) { animation-delay: 1600ms; color: var(--pink); }
  @keyframes fade { to { opacity: 1; } }

  /* Signature (fallback Corinthia until real SVG signature is delivered, §13.2) */
  .hero__sign {
    margin-top: 0.5rem;
    padding-left: clamp(4rem, 14vw, 13rem);
  }
  .hero__sign-text {
    display: inline-block;
    font-family: var(--font-sign);
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    line-height: 1.1;
    word-spacing: 0.12em;
    color: var(--pink-ink);
    transform: rotate(-3deg);
    transform-origin: left center;
    clip-path: inset(-20% 100% -20% 0);
    animation: sign 1400ms var(--ease-in-out) 1400ms forwards;
  }
  @keyframes sign { to { clip-path: inset(-20% -5% -20% 0); } }

  .hero__lead {
    margin-top: clamp(2rem, 4vw, 3rem);
    max-width: 34ch;
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    margin-top: 2.25rem;
  }

  /* --- Media --- */
  .hero__media {
    grid-column: 7 / -1;
    grid-row: 1;
    position: relative;
    margin-right: calc(var(--gutter-x) * -1);
  }
  .hero__media :global(picture) { position: absolute; inset: 0; display: block; }
  .hero__media :global(.hero__photo) {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 32rem;
    object-fit: cover;
    object-position: 40% 30%;
  }

  .hero__badge {
    position: absolute;
    left: clamp(-3rem, -3vw, -1rem);
    bottom: clamp(2rem, 6vh, 4rem);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 22rem;
    padding: 0.875rem 1.25rem 0.875rem 1rem;
    background: var(--white);
    border-left: 3px solid var(--p);
    box-shadow: 0 1px 0 var(--line);
    text-decoration: none;
    color: var(--text-main);
    transform: rotate(-1.5deg);
    transition: background-color var(--t-base) var(--ease-out-expo), transform var(--t-base) var(--ease-out-expo);
  }
  .hero__badge:hover { background: var(--p-tint); transform: rotate(0deg); }
  .hero__badge-date {
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .hero__badge-body { display: grid; line-height: 1.3; }
  .hero__badge-title { font-weight: 600; }
  .hero__badge-place { font-size: var(--fs-small); color: var(--text-muted); }

  /* Scroll cue: a dot travelling down the middle ray, once (no loop, §12) */
  .hero__cue {
    position: absolute;
    left: calc(var(--gutter-x) + 0px);
    bottom: 0;
    z-index: 2;
    display: block;
    width: 24px;
    height: 72px;
  }
  .hero__cue-line {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--line-strong);
  }
  .hero__cue-dot {
    position: absolute;
    left: calc(50% - 3px);
    top: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--pink);
    animation: cue 6s linear 2.2s both;
  }
  @keyframes cue { from { transform: translateY(0); } to { transform: translateY(62px); } }

  /* ---------- Tablet / mobile ---------- */
  @media (max-width: 1099px) {
    .hero__text { grid-column: 1 / span 8; }
    .hero__media { grid-column: 8 / -1; }
  }
  @media (max-width: 799px) {
    .hero__grid { display: block; min-height: 0; }
    .hero__text { padding-block: 3rem 2.5rem; }
    .hero__media { margin-inline: calc(var(--gutter-x) * -1); }
    .hero__media :global(picture) { position: static; }
    .hero__media :global(.hero__photo) { min-height: 0; height: auto; aspect-ratio: 4 / 5; object-position: 45% 25%; }
    .hero__badge { left: var(--gutter-x); bottom: 1.25rem; }
    .hero__cue { display: none; }
    .hero__watermark { top: 1rem; bottom: auto; left: auto; right: -14vw; width: 62vw; }
    .hero__sign { padding-left: 3.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__cue { display: none; }
    .hero__sign-text { clip-path: none; }
  }
</style>

<script>
  // Hide the badge if its event has passed since the last build (§4.4)
  const today = new Date().toISOString().slice(0, 10);
  document.querySelectorAll<HTMLElement>('[data-event-date]').forEach((el) => {
    if ((el.dataset.eventDate ?? '') < today) el.remove();
  });
</script>
